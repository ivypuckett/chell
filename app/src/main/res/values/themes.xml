<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chell" parent="android:Theme.Material.Light.NoActionBar">
        <!-- A launcher is a window onto the wallpaper, so it draws no
             background of its own. Both halves are required: the flag alone
             changes nothing behind an opaque window. -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
