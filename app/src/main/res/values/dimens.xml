<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One app cell. The height is applied to item_app so that the row count
         computed by GridMetrics matches what actually gets laid out. -->
    <dimen name="app_cell_width">88dp</dimen>
    <dimen name="app_cell_height">104dp</dimen>

    <!-- Shared by page_apps.xml and MainActivity.gridMetrics(); keeping it in
         one place stops the layout and the arithmetic from drifting apart. -->
    <dimen name="app_page_vertical_padding">24dp</dimen>

    <dimen name="app_icon_size">48dp</dimen>

    <!-- A folder's icon fills the same box an app's icon does, so a folder cell
         and an app cell are the same size in the grid. -->
    <dimen name="folder_icon_size">48dp</dimen>
    <dimen name="folder_plate_radius">12dp</dimen>
    <dimen name="folder_popup_padding">8dp</dimen>

    <!-- Past this many members the popup would be wider than a phone; the rest
         wrap onto further rows. -->
    <integer name="folder_popup_columns">4</integer>

    <dimen name="search_field_margin">16dp</dimen>

    <dimen name="favorites_row_padding">8dp</dimen>

    <dimen name="page_dot_size">8dp</dimen>
    <dimen name="page_dot_spacing">6dp</dimen>
    <dimen name="page_indicator_padding">16dp</dimen>
</resources>
