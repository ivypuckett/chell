<?xml version="1.0" encoding="utf-8"?>
<!-- The plate a folder's member icons are tiled on. Translucent white, so the
     wallpaper still shows through the way it does behind everything else, and
     rounded so the cell does not read as an app icon with a square background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FFFFFF" />
    <corners android:radius="@dimen/folder_plate_radius" />
    <size
        android:width="@dimen/folder_icon_size"
        android:height="@dimen/folder_icon_size" />
</shape>
